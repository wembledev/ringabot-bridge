# Copy to /etc/ringabot/ringabot.env (mode 0600, owner ringabot) or a local
# untracked .env. Leave values empty until you fill them on the host.
# Never commit filled values. Nothing here is shared with any other agent.

# xAI realtime voice. Model default: grok-voice-latest. Voice default: aurora.
XAI_API_KEY=
XAI_VOICE_MODEL=
XAI_VOICE=
XAI_REALTIME_URL=

# Voip.ms SIP sub-account. You create this in your own Voip.ms account.
# Server is the pop hostname Voip.ms shows you, for example a city pop.
VOIPMS_SIP_SERVER=
VOIPMS_SIP_USER=
VOIPMS_SIP_PASSWORD=
VOIPMS_DID=

# Persona. PERSONA_FILE is a YAML file (name, instructions, greeting, voice).
# Env values override the file when set.
PERSONA_NAME=
PERSONA_INSTRUCTIONS=
PERSONA_FILE=
GREETING=

# Seconds of silence before the assistant says goodbye and hangs up.
IDLE_TIMEOUT=
# Hard cap on one call. Default 600.
MAX_CALL_SECONDS=

# Optional HTTPS endpoint that receives signed tool calls and call.completed.
# Secret is the HMAC key. Requests also accept the API bearer token.
TOOLS_WEBHOOK_URL=
TOOLS_WEBHOOK_SECRET=
# Replay window for signed webhook timestamps, in seconds. Default 300.
WEBHOOK_REPLAY_WINDOW_SECONDS=
# Outbound webhook timeout, seconds. Default 2.
WEBHOOK_TIMEOUT_SECONDS=

# Bearer token for /mcp, /call, and webhook bearer auth. Generate at install.
API_TOKEN=
# 32-byte master key, base64. Prefer /etc/ringabot/master.key mode 0400.
RINGABOT_MASTER_KEY=
RINGABOT_MASTER_KEY_FILE=

PUBLIC_HOSTNAME=
# v1 does not answer inbound calls. Leave off.
INBOUND_MODE=
# on or off. Default off.
RECORDINGS=
RETENTION_DAYS=

# Comma-separated E.164 prefixes. Default +1 when unset.
ALLOWED_DESTINATIONS=
MAX_CALLS_PER_DAY=
MAX_CONCURRENT_CALLS=

# Bind address for the one HTTP server. Keep it on loopback behind Caddy.
HOST=
PORT=
DATA_DIR=
LOG_LEVEL=
RATE_LIMIT_PER_MINUTE=

# pulse (default) or memory (no sound hardware; for tests and load probes).
AUDIO_MODE=
# Optional host:port of an already running SIP ctrl. Empty starts baresip.
SIP_CTRL=
