# Copy to /etc/ringabot/ringabot.env (mode 0600). Fill values on the host only.
# Never commit filled values. Use your own xAI key, not one from another agent.

# Your xAI API key (server side only).
XAI_API_KEY=
# Standard Webhooks secret (whsec_...). `ringabot register-number` writes it here.
XAI_WEBHOOK_SECRET=
# Optional extra check: xAI sends this as a bearer token on every webhook.
XAI_WEBHOOK_BEARER=
# Bearer token for /calls admin endpoints. Generate with: openssl rand -hex 24
API_TOKEN=

# Your carrier number in E.164 or 10 digits. Calls to any other number are refused.
DID=
# Public https base URL that Caddy serves, e.g. https://203-0-113-7.sslip.io
PUBLIC_URL=
# Comma-separated carrier SIP signaling CIDRs allowed to send INVITEs to xAI.
SIP_ALLOWED_CIDRS=

# Listener (keep on loopback; Caddy terminates TLS).
HOST=
PORT=

# Agent persona.
VOICE=
INSTRUCTIONS=
INSTRUCTIONS_FILE=
GREETING=

# Limits. Defaults: 600 seconds, 2 concurrent calls, 20 calls kept in memory.
MAX_CALL_SECONDS=
MAX_CONCURRENT_CALLS=
KEEP_CALLS=
WEBHOOK_REPLAY_WINDOW_SECONDS=

# Transfers: comma list of name=uri, e.g. desk=tel:+16045550100
TRANSFER_TARGETS=

# Optional: extra function tools (JSON list in TOOLS_FILE) are POSTed to this URL,
# signed with Standard Webhooks headers using TOOLS_FORWARD_SECRET.
TOOLS_FILE=
TOOLS_FORWARD_URL=
TOOLS_FORWARD_SECRET=
TOOL_TIMEOUT_SECONDS=
