[Unit]
Description=Ringabot bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ringabot
Group=ringabot
SupplementaryGroups=audio
EnvironmentFile=/etc/ringabot/ringabot.env
Environment=XDG_RUNTIME_DIR=/run/ringabot
RuntimeDirectory=ringabot
WorkingDirectory=/opt/ringabot
ExecStartPre=-+/sbin/modprobe snd-aloop
ExecStart=/opt/ringabot/.venv/bin/ringabot serve
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ringabot
MemoryMax=800M
LimitNOFILE=4096
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
